{
  "name": "@xmesh/ui-mcp",
  "version": "0.1.0",
  "description": "Distributed Web and Electron test execution over MCP",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "xmesh-ui-mcp": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/src",
    "schemas",
    "examples",
    "README.md",
    "AGENT-USAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:browser": "npm run build && node --test --test-concurrency=1 dist/test/browser/*.test.js",
    "generate": "node scripts/generate.mjs",
    "check-types": "node scripts/generate.mjs --check",
    "benchmark": "npm run build && node dist/test/benchmark.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2"
  }
}
