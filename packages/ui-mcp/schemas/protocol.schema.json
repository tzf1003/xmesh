{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:xmesh:ui:protocol:1",
  "title": "UIProtocol",
  "$defs": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "css": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "within": { "$ref": "#/$defs/Target" },
        "frame": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["testId"] },
        { "required": ["role"] },
        { "required": ["label"] },
        { "required": ["text"] },
        { "required": ["css"] },
        { "required": ["alias"] }
      ]
    },
    "Expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "text": { "type": "string" },
        "containsText": { "type": "string" },
        "value": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "url": { "type": "string" }
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": {
          "enum": [
            "navigate",
            "select_page",
            "wait_page",
            "click",
            "fill",
            "press",
            "check",
            "select",
            "hover",
            "scroll",
            "upload",
            "download",
            "wait",
            "assert",
            "screenshot",
            "read",
            "response",
            "dialog"
          ]
        },
        "target": { "$ref": "#/$defs/Target" },
        "expect": { "$ref": "#/$defs/Expectation" },
        "value": { "type": "string" },
        "secret": { "type": "string", "minLength": 1 },
        "checked": { "type": "boolean" },
        "page_id": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "accept": { "type": "boolean" }
      },
      "required": ["id", "action"],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "click",
                  "fill",
                  "press",
                  "check",
                  "select",
                  "hover",
                  "scroll",
                  "upload",
                  "download",
                  "read"
                ]
              }
            }
          },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "enum": ["assert", "wait"] } } },
          "then": { "required": ["expect"] }
        },
        {
          "if": {
            "properties": {
              "action": { "enum": ["navigate", "press", "select", "response"] }
            }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "action": { "const": "fill" } } },
          "then": {
            "oneOf": [{ "required": ["value"] }, { "required": ["secret"] }]
          }
        },
        {
          "if": { "properties": { "action": { "const": "select_page" } } },
          "then": { "required": ["page_id"] }
        },
        {
          "if": { "properties": { "action": { "const": "upload" } } },
          "then": { "required": ["file"] }
        },
        {
          "if": { "properties": { "action": { "const": "response" } } },
          "then": { "required": ["status"] }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["assert", "wait"] } },
            "required": ["expect"]
          },
          "then": {
            "anyOf": [
              { "required": ["target"] },
              { "properties": { "expect": { "required": ["url"] } } }
            ]
          }
        }
      ]
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Step" }
        }
      },
      "required": ["protocol_version", "session_id", "request_id", "steps"]
    },
    "ScriptRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "code": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "params": { "type": "object" }
      },
      "required": ["protocol_version", "session_id", "request_id", "code"]
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/RunRequest" },
    { "$ref": "#/$defs/ScriptRequest" }
  ]
}
