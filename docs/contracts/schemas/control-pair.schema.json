{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-pair:2",
  "title": "ControlPair",
  "description": "CTR-CTL-08。设备统一配对和信任管理。LAN、Tailnet 共用 xmesh 公钥信任。",
  "$defs": {
    "PairFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "设备 SPKI 公钥的 SHA-256，与 device_id 的摘要一致。"
    },
    "PairDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "device_id",
        "public_key",
        "name",
        "fingerprint",
        "tags"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "version": {
          "const": 2
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "public_key": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 1
        }
      }
    },
    "PairExportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair"
      ],
      "properties": {
        "pair": {
          "$ref": "#/$defs/PairDocument"
        }
      }
    },
    "PairImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair",
        "fingerprint"
      ],
      "properties": {
        "pair": {
          "$ref": "#/$defs/PairDocument"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}$",
          "description": "用户独立核对的设备公钥指纹。与设备 ID、公钥和文档内指纹同时验证。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tag:peer",
              "tag:device",
              "tag:ingress",
              "tag:admin"
            ]
          },
          "default": [
            "tag:peer",
            "tag:device"
          ]
        }
      }
    },
    "PairImportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "tags",
        "restart_required"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "restart_required": {
          "const": false,
          "description": "共享信任服务即时生效。"
        }
      }
    },
    "PairTrustUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tag:peer",
              "tag:device",
              "tag:ingress",
              "tag:admin"
            ]
          },
          "description": "替换该设备的全部角色。只增加角色不打断现有逻辑会话；去掉任一角色会结束该设备现有的逻辑会话。"
        }
      }
    },
    "PairTrustUpdateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "tags"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^dev-[0-9a-f]{64}$"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        }
      }
    },
    "PairAddress": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "description": "HTTPS 设备端点；手动输入主机或主机:端口时由内核补全为 https://host:7433。"
    },
    "PairPassword": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^\\S[\\s\\S]*\\S$",
      "description": "连接密码。长度按 Unicode 码点计，首尾不能是空白。"
    },
    "PairPasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "$ref": "#/$defs/PairPassword"
        }
      }
    },
    "PairPasswordState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "updated_at",
        "failed_attempts",
        "locked_until"
      ],
      "properties": {
        "set": {
          "type": "boolean",
          "description": "未设置时为 false，此时对端无法通过密码配对本机。"
        },
        "updated_at": {
          "anyOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "最近一次设置或修改的时间，未设置时为 null。"
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "对端连续失败次数。成功配对后清零。"
        },
        "locked_until": {
          "anyOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "限流锁定截止时间，未锁定时为 null。从不包含口令或派生值。"
        }
      }
    },
    "PairDiscoveredDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "address",
        "seen_at",
        "device_id",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "seen_at": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet"
          ]
        }
      }
    },
    "PairDiscoveredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PairDiscoveredDevice"
          },
          "description": "尚未配对、且宣告了 pairing=1 的设备。已配对的设备不出现在这里。"
        }
      }
    },
    "PairConnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "if": {
        "required": [
          "address"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "fingerprint"
        ]
      },
      "description": "address 与 fingerprint 至少给一个。",
      "properties": {
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint",
          "description": "期望设备公钥指纹；只给指纹时从发现列表选择对应设备。"
        },
        "password": {
          "$ref": "#/$defs/PairPassword"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet",
            "cloudflare"
          ],
          "default": "lan"
        }
      }
    },
    "PairConnectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "address",
        "tags",
        "device_id",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet",
            "cloudflare"
          ]
        }
      }
    },
    "CloudflareOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "tunnel_token",
        "access_id",
        "access_secret",
        "peer_hostname"
      ],
      "description": "对端加入发送者的 Cloudflare 网格所需的内容：对端自己的隧道与 Access 服务令牌，以及发送者的主机名。不含 Cloudflare API Token。",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "接收设备自己那条隧道的公网主机名。"
        },
        "tunnel_token": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[!-~]+$",
          "description": "运行接收设备 cloudflared 的隧道令牌。"
        },
        "access_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[!-~]+$",
          "description": "Access 服务令牌的 Client ID，用于拨号其他设备。"
        },
        "access_secret": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[!-~]+$",
          "description": "Access 服务令牌的 Client Secret。"
        },
        "peer_hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "发送设备的隧道主机名，接收设备把它记作发送设备的地址。"
        }
      }
    },
    "DeviceOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "description": "已配对设备向另一台设备提议的一种连接方式。接收设备的用户确认前不会应用。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "发送方生成的 128 位随机编号。"
        },
        "kind": {
          "enum": [
            "cloudflare",
            "tailnet"
          ]
        },
        "cloudflare": {
          "$ref": "#/$defs/CloudflareOffer"
        },
        "tailnet": {
          "$ref": "#/$defs/TailnetOffer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cloudflare"
              }
            }
          },
          "then": {
            "required": [
              "cloudflare"
            ],
            "not": {
              "required": [
                "tailnet"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tailnet"
              }
            }
          },
          "then": {
            "required": [
              "tailnet"
            ],
            "not": {
              "required": [
                "cloudflare"
              ]
            }
          }
        }
      ]
    },
    "OfferSendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "offer"
      ],
      "description": "把一条连接方式提议投递给已配对设备。",
      "properties": {
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "offer": {
          "$ref": "#/$defs/DeviceOffer"
        }
      }
    },
    "OfferCloudflareSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "peer_hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "本设备将使用的隧道主机名。"
        },
        "peer_hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]+$",
          "description": "发送设备的隧道主机名。"
        }
      }
    },
    "OfferSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from_id",
        "from_name",
        "received_at",
        "expires_at"
      ],
      "description": "收到的连接方式提议。发送者是连接验证出的设备，不含任何凭据。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "cloudflare",
            "tailnet"
          ]
        },
        "from_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "from_name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "received_at": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
        },
        "cloudflare": {
          "$ref": "#/$defs/OfferCloudflareSummary"
        },
        "tailnet": {
          "$ref": "#/$defs/OfferTailnetSummary"
        }
      }
    },
    "OffersResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offers"
      ],
      "properties": {
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OfferSummary"
          },
          "maxItems": 16
        }
      }
    },
    "OfferAcceptResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "restart_required",
        "changed_paths"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cloudflare",
            "tailnet"
          ]
        },
        "restart_required": {
          "type": "boolean",
          "description": "为真时运行中的节点需要重启才会使用这条连接方式。"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OfferSendResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery"
      ],
      "description": "提议如何到达对方：delivered 已进入对方收件箱；queued 本机拨不通对方，已留在本机，等对方经它自己的连接来取。",
      "properties": {
        "delivery": {
          "enum": [
            "delivered",
            "queued"
          ]
        }
      }
    },
    "TailnetOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_key"
      ],
      "description": "接收设备加入发送者 tailnet 所需的预授权密钥。ControlURL 为空表示 Tailscale 官方服务，否则是 Headscale 地址。密钥自带的标签由控制面决定，与设备的 xmesh 标签无关。",
      "properties": {
        "control_url": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^https://[A-Za-z0-9.:\\[\\]-]+/?$",
          "description": "Headscale 控制面地址；留空表示 Tailscale 官方服务。"
        },
        "auth_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 4096,
          "pattern": "^[!-~]+$",
          "description": "预授权密钥。"
        },
        "ephemeral": {
          "type": "boolean",
          "description": "是否把接收设备注册为临时节点。"
        }
      }
    },
    "OfferTailnetSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_url": {
          "type": "string",
          "maxLength": 255,
          "description": "控制面地址；省略表示 Tailscale 官方服务。"
        },
        "ephemeral": {
          "type": "boolean"
        }
      }
    }
  }
}
