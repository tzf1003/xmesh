{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-pair:2",
  "title": "ControlPair",
  "description": "CTR-CTL-08。设备统一配对和信任管理。LAN、Tailnet 共用 xmesh 公钥信任。",
  "$defs": {
    "PairFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "设备 SPKI 公钥的 SHA-256，与 device_id 的摘要一致。"
    },
    "PairDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "device_id",
        "public_key",
        "name",
        "fingerprint",
        "tags"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "version": {
          "const": 2
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "public_key": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 1
        }
      }
    },
    "PairExportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair"
      ],
      "properties": {
        "pair": {
          "$ref": "#/$defs/PairDocument"
        }
      }
    },
    "PairImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair",
        "fingerprint"
      ],
      "properties": {
        "pair": {
          "$ref": "#/$defs/PairDocument"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}$",
          "description": "用户独立核对的设备公钥指纹。与设备 ID、公钥和文档内指纹同时验证。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tag:peer",
              "tag:device",
              "tag:ingress"
            ]
          },
          "default": [
            "tag:peer",
            "tag:device"
          ]
        }
      }
    },
    "PairImportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "tags",
        "restart_required"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "restart_required": {
          "const": false,
          "description": "共享信任服务即时生效。"
        }
      }
    },
    "PairAddress": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "description": "HTTPS 设备端点；手动输入主机或主机:端口时由内核补全为 https://host:7433。"
    },
    "PairPassword": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^\\S[\\s\\S]*\\S$",
      "description": "连接密码。长度按 Unicode 码点计，首尾不能是空白。"
    },
    "PairPasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "$ref": "#/$defs/PairPassword"
        }
      }
    },
    "PairPasswordState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "updated_at",
        "failed_attempts",
        "locked_until"
      ],
      "properties": {
        "set": {
          "type": "boolean",
          "description": "未设置时为 false，此时对端无法通过密码配对本机。"
        },
        "updated_at": {
          "anyOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "最近一次设置或修改的时间，未设置时为 null。"
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "对端连续失败次数。成功配对后清零。"
        },
        "locked_until": {
          "anyOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "限流锁定截止时间，未锁定时为 null。从不包含口令或派生值。"
        }
      }
    },
    "PairDiscoveredDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "address",
        "seen_at",
        "device_id",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "seen_at": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet"
          ]
        }
      }
    },
    "PairDiscoveredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PairDiscoveredDevice"
          },
          "description": "尚未配对、且宣告了 pairing=1 的设备。已配对的设备不出现在这里。"
        }
      }
    },
    "PairConnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "if": {
        "required": [
          "address"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "fingerprint"
        ]
      },
      "description": "address 与 fingerprint 至少给一个。",
      "properties": {
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint",
          "description": "期望设备公钥指纹；只给指纹时从发现列表选择对应设备。"
        },
        "password": {
          "$ref": "#/$defs/PairPassword"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet"
          ],
          "default": "lan"
        }
      }
    },
    "PairConnectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "address",
        "tags",
        "device_id",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "fingerprint": {
          "$ref": "#/$defs/PairFingerprint"
        },
        "address": {
          "$ref": "#/$defs/PairAddress"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "path": {
          "enum": [
            "lan",
            "tailnet"
          ]
        }
      }
    }
  }
}
