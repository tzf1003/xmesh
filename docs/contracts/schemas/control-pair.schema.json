{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-pair:1",
  "title": "ControlPair",
  "description": "CTR-CTL-08。LAN 配对。只在 mesh.mode 为 lan 时可用，否则 unsupported_mode。配对文档只含公开证书。",
  "$defs": {
    "PairFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "证书 SHA-256，小写十六进制，无分隔符。"
    },
    "PairDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fingerprint", "certificate_pem", "tags"],
      "properties": {
        "name": { "$ref": "urn:xmesh:schema:control-common:1#/$defs/NodeName" },
        "fingerprint": { "$ref": "#/$defs/PairFingerprint" },
        "certificate_pem": { "type": "string", "pattern": "^-----BEGIN CERTIFICATE-----" },
        "tags": {
          "type": "array",
          "items": { "$ref": "urn:xmesh:schema:control-common:1#/$defs/Tag" }
        }
      }
    },
    "PairExportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair"],
      "properties": {
        "pair": { "$ref": "#/$defs/PairDocument" }
      }
    },
    "PairImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair", "fingerprint"],
      "properties": {
        "pair": { "$ref": "#/$defs/PairDocument" },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}$",
          "description": "用户在另一台设备上独立核对过的指纹。必须由 UI 用户确认后提交，内核比较它与 pair.fingerprint（忽略冒号与大小写），不一致返回 fingerprint_mismatch。"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tag:peer", "tag:device", "tag:ingress"] },
          "default": ["tag:peer", "tag:device"]
        }
      }
    },
    "PairImportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fingerprint", "tags", "restart_required"],
      "properties": {
        "name": { "$ref": "urn:xmesh:schema:control-common:1#/$defs/NodeName" },
        "fingerprint": { "$ref": "#/$defs/PairFingerprint" },
        "tags": { "type": "array", "items": { "$ref": "urn:xmesh:schema:control-common:1#/$defs/Tag" } },
        "restart_required": { "type": "boolean", "description": "与 xmesh pair 一致，重启节点后信任才生效时为 true。" }
      }
    }
  }
}
