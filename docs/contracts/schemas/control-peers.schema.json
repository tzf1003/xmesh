{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-peers:2",
  "title": "ControlPeers",
  "description": "CTR-CTL-05。GET /v2/peers。数据来自 mesh 层，不含任何工具调用内容。",
  "$defs": {
    "Peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "self",
        "node_id",
        "tags",
        "online",
        "connection",
        "derp_region",
        "addrs",
        "last_seen",
        "os",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName"
        },
        "self": {
          "type": "boolean",
          "description": "本机自己。恰有一项为 true。"
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:xmesh:schema:control-common:2#/$defs/Tag"
          }
        },
        "online": {
          "type": "boolean"
        },
        "connection": {
          "enum": [
            "direct",
            "derp",
            "unknown",
            "local"
          ],
          "description": "direct 为点对点，derp 为经中继，unknown 为离线或尚未探测，local 为本机自己。"
        },
        "derp_region": {
          "type": [
            "string",
            "null"
          ],
          "description": "connection 为 derp 时的区域名。"
        },
        "addrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "网络内地址，不含公网地址。"
        },
        "last_seen": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "对端内核版本，未知为 null。"
        },
        "info": {
          "$ref": "#/$defs/PeerInfo"
        },
        "device_id": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DeviceId"
        },
        "display_name": {
          "type": "string"
        },
        "trust_state": {
          "enum": [
            "self",
            "paired",
            "identity_conflict"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DevicePath"
          }
        },
        "active_path": {
          "enum": [
            "lan",
            "tailnet",
            "direct",
            "cloudflare"
          ]
        },
        "connection_state": {
          "enum": [
            "online",
            "unstable",
            "reconnecting",
            "offline",
            "identity_conflict"
          ]
        }
      }
    },
    "PeerInfo": {
      "type": "object",
      "description": "网关对该设备 sys.info 的后台读取结果（1.1 起）。本节点自己、离线设备、没有网关角色的节点上省略。",
      "additionalProperties": false,
      "required": [
        "refreshed_at",
        "error"
      ],
      "properties": {
        "refreshed_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "最近一次成功读取的时间；第一次读取完成前为 null。"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "最近一次读取失败的原因；成功之后以及读取完成前为 null。"
        }
      }
    },
    "PeersResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peers"
      ],
      "properties": {
        "peers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Peer"
          }
        }
      }
    },
    "DevicePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "address",
        "reachable",
        "verified_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lan",
            "tailnet",
            "direct",
            "cloudflare"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "reachable": {
          "type": "boolean"
        },
        "verified_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "$ref": "#/$defs/PathQuality"
        }
      }
    },
    "PathQuality": {
      "type": "object",
      "description": "最近约 5 分钟的探测结果。延时是一次完整认证探测（建连、TLS、身份）的耗时，各路径之间可比，但高于单纯 ping。",
      "additionalProperties": false,
      "required": [
        "samples",
        "latency_ms",
        "p90_ms",
        "jitter_ms",
        "loss",
        "flaps"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "成功探测耗时的中位数；没有成功探测为 0。"
        },
        "p90_ms": {
          "type": "number",
          "minimum": 0
        },
        "jitter_ms": {
          "type": "number",
          "minimum": 0,
          "description": "p90 与中位数之差。"
        },
        "loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "窗口内探测失败的比例。"
        },
        "flaps": {
          "type": "integer",
          "minimum": 0,
          "description": "窗口内成功之后紧接着失败的次数，用来识别随机阻断。"
        },
        "score": {
          "type": "number",
          "description": "智能选路用来给这条路径排序的分数，越低越好；探测样本太少、还不能打分时省略。"
        }
      }
    }
  }
}
