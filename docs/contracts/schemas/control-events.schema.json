{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-events:2",
  "title": "ControlEvents",
  "description": "CTR-CTL-04。GET /v2/events 的 SSE 流。每个 SSE 事件的 data 行是下面某个事件对象的紧凑 JSON；id 行等于对象里的 id。事件只含元数据，禁止出现命令、参数、路径内容、stdout、stderr、终端数据、环境变量值。",
  "$defs": {
    "HelloData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_id", "head", "heartbeat_s"],
      "properties": {
        "boot_id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/BootId" },
        "head": {
          "oneOf": [
            { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
            { "type": "null" }
          ],
          "description": "环形缓存里最新一条事件的 id。还没有事件时是 null。"
        },
        "heartbeat_s": { "type": "integer", "minimum": 1, "description": "服务端发送注释行 ping 的间隔。" }
      }
    },
    "ResetData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "head"],
      "properties": {
        "reason": {
          "enum": ["gap", "boot_changed"],
          "description": "gap：Last-Event-ID 早于环形缓存里最旧的一条。boot_changed：Last-Event-ID 属于上一次启动。"
        },
        "head": {
          "oneOf": [
            { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
            { "type": "null" }
          ]
        }
      }
    },
    "HelloEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "time", "data"],
      "properties": {
        "type": { "const": "hello" },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "data": { "$ref": "#/$defs/HelloData" }
      }
    },
    "ResetEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "time", "data"],
      "properties": {
        "type": { "const": "reset" },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "data": { "$ref": "#/$defs/ResetData" }
      }
    },
    "PeerEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "peer"],
      "properties": {
        "change": { "enum": ["added", "updated", "removed", "online", "offline"] },
        "peer": { "$ref": "urn:xmesh:schema:control-peers:2#/$defs/Peer" }
      }
    },
    "CallEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "device", "caller", "oauth_client", "status", "error", "duration_ms"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "description": "对外工具名，如 exec.run。" },
        "device": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/NodeName", "description": "工具实际执行的节点。" },
        "caller": { "type": "string", "minLength": 1 },
        "oauth_client": { "type": ["string", "null"] },
        "status": { "enum": ["ok", "error"] },
        "error": {
          "oneOf": [
            { "$ref": "urn:xmesh:schema:error:1#/properties/error" },
            { "type": "null" }
          ],
          "description": "失败时的 CTR-ERR-01 错误码，成功为 null。"
        },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "string" } } },
          "else": { "properties": { "error": { "type": "null" } } }
        }
      ]
    },
    "SessionEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "session"],
      "properties": {
        "change": { "enum": ["opened", "updated", "closed", "released"] },
        "session": { "$ref": "urn:xmesh:schema:control-sessions:2#/$defs/Session" }
      }
    },
    "WarningEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "warning"],
      "properties": {
        "change": { "enum": ["raised", "cleared"] },
        "warning": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Warning" }
      }
    },
    "ConfigEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "actor", "etag", "restart_required", "changed_paths"],
      "properties": {
        "change": { "enum": ["reloaded", "reload_failed", "written"] },
        "actor": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Actor" },
        "etag": {
          "oneOf": [
            { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Etag" },
            { "type": "null" }
          ],
          "description": "磁盘上文件的 ETag。读不到文件时是 null。"
        },
        "restart_required": { "type": "boolean" },
        "changed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "RFC 6901 JSON Pointer 列表，只有位置，没有取值。"
        }
      }
    },
    "LifecycleEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "drain"],
      "properties": {
        "change": { "enum": ["running", "draining", "resumed", "stopping"] },
        "drain": { "$ref": "urn:xmesh:schema:control-drain:2#/$defs/DrainState" }
      }
    },
    "StatusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "status" },
        "data": { "$ref": "urn:xmesh:schema:control-status:2#/$defs/StatusResponse" }
      }
    },
    "PeerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "peer" },
        "data": { "$ref": "#/$defs/PeerEventData" }
      }
    },
    "CallEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "call" },
        "data": { "$ref": "#/$defs/CallEventData" }
      }
    },
    "SessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "session" },
        "data": { "$ref": "#/$defs/SessionEventData" }
      }
    },
    "WarningEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "warning" },
        "data": { "$ref": "#/$defs/WarningEventData" }
      }
    },
    "ConfigEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "config" },
        "data": { "$ref": "#/$defs/ConfigEventData" }
      }
    },
    "LifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "time", "type", "data"],
      "properties": {
        "id": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/EventId" },
        "seq": { "type": "integer", "minimum": 1 },
        "time": { "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp" },
        "type": { "const": "lifecycle" },
        "data": { "$ref": "#/$defs/LifecycleEventData" }
      }
    },
    "ControlEvent": {
      "oneOf": [
        { "$ref": "#/$defs/HelloEvent" },
        { "$ref": "#/$defs/ResetEvent" },
        { "$ref": "#/$defs/StatusEvent" },
        { "$ref": "#/$defs/PeerEvent" },
        { "$ref": "#/$defs/CallEvent" },
        { "$ref": "#/$defs/SessionEvent" },
        { "$ref": "#/$defs/WarningEvent" },
        { "$ref": "#/$defs/ConfigEvent" },
        { "$ref": "#/$defs/LifecycleEvent" }
      ]
    }
  }
}
