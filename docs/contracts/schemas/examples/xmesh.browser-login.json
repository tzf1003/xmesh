{
  "node": {
    "name": "browser-node",
    "roles": [
      "agent",
      "gateway"
    ]
  },
  "mesh": {
    "mode": "tailnet",
    "control_url": "https://controlplane.tailscale.com",
    "auth_method": "browser"
  },
  "gateway": {
    "listen": "127.0.0.1:8080"
  },
  "agent": {
    "default_cwd": "/workspace",
    "cwd_policy": {
      "allow": [
        "/workspace"
      ]
    },
    "authz": {
      "tag:device": {
        "tools": [
          "*"
        ],
        "backends": [
          "*"
        ]
      }
    }
  }
}
