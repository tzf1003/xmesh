{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-preferred-ip:2",
  "title": "Cloudflare 优选 IP",
  "description": "API 2.4 起（2.5 加机房与地区）。池与测速状态只读；来源、策略与按设备覆盖写在 mesh.cloudflare.preferred_ip，经 PATCH /v2/config 修改。",
  "$defs": {
    "PreferredIPEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip",
        "source",
        "status",
        "latency_ms",
        "loss_percent",
        "failures",
        "cooldown_until",
        "last_used_at",
        "colo",
        "region"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },
        "source": {
          "enum": [
            "manual",
            "file",
            "url",
            "scan"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "untested",
            "cooling"
          ]
        },
        "latency_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "loss_percent": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "cooldown_until": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_used_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "colo": {
          "type": "string",
          "description": "2.5 起。最近一次测速看到的 Cloudflare 机房（IATA 三字母代码），未读到为空串。"
        },
        "region": {
          "type": "string",
          "description": "2.5 起。机房所属地区：hk、jp、kr、sg、sea、us-w、us-e、eu、other；colo 为空时为空串。"
        }
      }
    },
    "PreferredIPSourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "type",
        "name",
        "disabled",
        "count",
        "fetched_at",
        "error"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": -1
        },
        "type": {
          "enum": [
            "manual",
            "file",
            "url",
            "scan"
          ]
        },
        "name": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "fetched_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "description": "index 为 -1 表示旧的 preferred_ips / preferred_ips_file 字段。"
    },
    "PreferredIPScanState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "running",
        "sample",
        "host",
        "started_at",
        "last_at",
        "next_at",
        "kept",
        "error",
        "regions",
        "chosen",
        "unidentified"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "sample": {
          "type": "integer",
          "minimum": 0
        },
        "host": {
          "type": "string"
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "kept": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "description": "2.5 起。上次测速里应答地址按地区的分布，最快的地区在前。",
          "items": {
            "$ref": "#/$defs/PreferredIPRegion"
          }
        },
        "chosen": {
          "type": "array",
          "description": "2.5 起。上次测速保留地址的地区键或机房代码；没做地区筛选时为空。",
          "items": {
            "type": "string"
          }
        },
        "unidentified": {
          "type": "integer",
          "minimum": 0,
          "description": "2.5 起。应答但读不到机房的地址数。"
        }
      }
    },
    "PreferredIPPeerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "hostname",
        "mode",
        "override",
        "ips",
        "current",
        "last_at"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "smart",
            "fixed",
            "off"
          ]
        },
        "override": {
          "type": "boolean"
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "string"
        },
        "last_at": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "current 为空表示最近一次连接走了 DNS 地址或尚未连接。"
    },
    "PreferredIPState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "no_dns_fallback",
        "pool",
        "sources",
        "scan",
        "peers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "smart",
            "fixed"
          ]
        },
        "no_dns_fallback": {
          "type": "boolean"
        },
        "pool": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferredIPEntry"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferredIPSourceState"
          }
        },
        "scan": {
          "$ref": "#/$defs/PreferredIPScanState"
        },
        "peers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferredIPPeerState"
          }
        }
      },
      "description": "GET /v2/preferred-ip 与 POST /v2/preferred-ip/run 的响应。池、评分与来源状态；改设置走 PATCH /v2/config。"
    },
    "PreferredIPRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "enum": [
            "scan",
            "refresh"
          ]
        }
      },
      "description": "scan 在后台开始测速，立即返回；refresh 抓取所有订阅来源，完成后返回。"
    },
    "PreferredIPInspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32768
        }
      }
    },
    "PreferredIPInspectItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "ip",
        "status",
        "note"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "ip": {
          "type": "string"
        },
        "status": {
          "enum": [
            "new",
            "existing",
            "rejected"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "PreferredIPInspectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "accepted"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferredIPInspectItem"
          }
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "accepted 是去重后可以导入的新地址。"
    },
    "PreferredIPRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "count",
        "best_ms",
        "colos"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "best_ms": {
          "type": "integer",
          "minimum": 0
        },
        "colos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
