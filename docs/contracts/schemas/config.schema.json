{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:config:1",
  "title": "xmesh.yaml",
  "description": "CTR-CFG-01。YAML 解析成 JSON 数据模型后再校验。进程启动时还要执行模式表达不了的规则：回环监听、Headscale 禁止 Funnel、HTTP 后端必须是回环或 tailnet、relay 拒绝启动。",
  "type": "object",
  "additionalProperties": false,
  "required": ["node", "mesh", "agent"],
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?)(ns|us|µs|ms|s|m|h)(([0-9]+(\\.[0-9]+)?)(ns|us|µs|ms|s|m|h))*$"
    },
    "size": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)([KMGT]iB|B)?$"
    },
    "nodeName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}$"
    },
    "backendName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}$",
      "not": { "enum": ["computer"] }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "description": "每个主体的调用预算。省略的字段取默认值：每小时 10000 次、并发 64、单次最长 10m。",
      "properties": {
        "calls_per_hour": { "type": "integer", "minimum": 1, "default": 10000 },
        "max_concurrent": { "type": "integer", "minimum": 1, "default": 64 },
        "max_call_duration": { "$ref": "#/$defs/duration", "default": "10m" }
      }
    },
    "gatewayAccess": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(localhost|lan|tailnet|[0-9A-Fa-f:.]+(/[0-9]{1,3})?)$",
      "description": "localhost、lan、tailnet，或单个 IP、CIDR。语义见 CTR-GW-07。"
    },
    "gatewayHost": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "description": "额外接受的主机名。不能是 IP；不带 TLS。"
    },
    "scope": {
      "type": "string",
      "pattern": "^(devices:read|exec:(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|pty:(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|fs:(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|fs:(read|write):(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|sys:(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|computer:(observe|control|clipboard-read|clipboard-write):(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62})|backend:(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62}):(\\*|[A-Za-z0-9][A-Za-z0-9-]{0,62}))$"
    },
    "ciId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "ciLabel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 2, "description": "新版设备身份与连接配置；升级后重新配对。" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles"],
      "properties": {
        "name": { "$ref": "#/$defs/nodeName" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["agent", "gateway", "ingress"] }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "tailnet",
            "lan"
          ],
          "description": "relay 不在枚举内。出现该值时模式校验失败，进程不得启动。见 CON-NET-08。"
        },
        "control_url": {
          "type": "string",
          "format": "uri"
        },
        "authkey_file": {
          "type": "string",
          "minLength": 1
        },
        "auth_method": {
          "enum": [
            "authkey",
            "browser"
          ],
          "default": "authkey",
          "description": "browser 使用已在本机完成浏览器授权的持久 tsnet 身份。"
        },
        "ephemeral": {
          "type": "boolean",
          "default": false,
          "description": "短生命周期 tailnet 节点；节点凭据只存内存，退出时尝试注销。"
        },
        "lan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mdns": {
              "type": "boolean"
            },
            "interface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "监听和 mDNS 通告使用的网卡名（如 WLAN、en0、eth0）。缺省时选第一块带私有 IPv4 的启用网卡，并跳过虚拟机、容器、WSL、Hyper-V、VPN 隧道等虚拟网卡；指定的网卡不存在或没有私有 IPv4 时拒绝启动。"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "path_selection": {
          "type": "object",
          "additionalProperties": false,
          "description": "多条路径同时可用时，设备之间用哪一条。",
          "properties": {
            "mode": {
              "enum": [
                "smart",
                "manual"
              ],
              "default": "smart",
              "description": "smart 根据实测的延时、丢包和断流选最稳的路径，只在另一条路径明显且持续更好、或当前路径出问题时才换，priority 用来在没有测量数据或分数接近时排序；manual 严格按 priority 的顺序，第一条能连上的路径胜出。"
            },
            "priority": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "lan",
                  "tailnet",
                  "cloudflare"
                ]
              },
              "description": "从最优先到最不优先。没有列出的路径按 lan、tailnet、cloudflare 的默认顺序排在后面。"
            },
            "disabled": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "lan",
                  "tailnet",
                  "cloudflare"
                ]
              },
              "description": "不拨出、也不接受设备链路的路径。"
            }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "description": "经 Cloudflare Tunnel 互连，设备不需要公网地址。每台设备运行自己的 cloudflared，内层仍是固定公钥的 mTLS。",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "hostname": {
              "type": "string",
              "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
              "description": "本机隧道的主机名。留空表示只拨出，不接受连接。"
            },
            "listen": {
              "type": "string",
              "default": "127.0.0.1:7434",
              "description": "cloudflared 以 tcp:// 转发到的回环地址。"
            },
            "access_client_id": {
              "type": "string",
              "minLength": 1
            },
            "access_client_secret_file": {
              "type": "string",
              "minLength": 1,
              "description": "绝对路径，文件权限 0600，保存 Access 服务令牌的密钥。须与 access_client_id 同时填写。"
            },
            "tunnel_token_file": {
              "type": "string",
              "minLength": 1,
              "description": "绝对路径，文件权限 0600，保存隧道令牌。填写后内核自己运行 cloudflared（--protocol http2），需要 hostname。"
            },
            "cloudflared": {
              "type": "string",
              "minLength": 1,
              "description": "cloudflared 可执行文件，缺省从 PATH 查找。只在 tunnel_token_file 时使用。"
            },
            "peers": {
              "type": "object",
              "propertyNames": {
                "pattern": "^dev-[0-9a-f]{64}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
              },
              "description": "已配对设备的 ID 到隧道主机名。"
            },
            "allow_pairing": {
              "type": "boolean",
              "default": false,
              "description": "未设置连接密码时也允许未配对设备到达隧道上的配对入口。默认关闭：只有设置了连接密码（例如邀请新设备期间）才接受未配对设备。"
            }
          }
        },
        "tailnet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "control_url": {
              "type": "string",
              "format": "uri"
            },
            "authkey_file": {
              "type": "string",
              "minLength": 1
            },
            "auth_method": {
              "enum": [
                "authkey",
                "browser"
              ],
              "default": "authkey"
            },
            "ephemeral": {
              "type": "boolean",
              "default": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "control_url"
                ],
                "if": {
                  "properties": {
                    "auth_method": {
                      "const": "browser"
                    }
                  },
                  "required": [
                    "auth_method"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "authkey_file"
                        ]
                      },
                      {
                        "properties": {
                          "ephemeral": {
                            "const": true
                          }
                        },
                        "required": [
                          "ephemeral"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "authkey_file"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tailnet"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "control_url"
            ],
            "if": {
              "properties": {
                "auth_method": {
                  "const": "browser"
                }
              },
              "required": [
                "auth_method"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "authkey_file"
                    ]
                  },
                  {
                    "properties": {
                      "ephemeral": {
                        "const": true
                      }
                    },
                    "required": [
                      "ephemeral"
                    ]
                  }
                ]
              }
            },
            "else": {
              "required": [
                "authkey_file"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "lan"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "lan"
            ],
            "properties": {
              "ephemeral": { "const": false },
              "lan": { "required": ["mdns"] }
            }
          }
        }
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen"],
      "properties": {
        "listen": {
          "type": "string",
          "default": ":8080",
          "pattern": "^(:|0\\.0\\.0\\.0:|\\[::\\]:|127\\.0\\.0\\.1:|\\[::1\\]:)([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "description": "本地监听地址。空主机或 0.0.0.0、[::] 为所有网卡；127.0.0.1、[::1] 只绑回环，此时其他设备不可达。哪些来源能连接由 access 决定（CTR-GW-07）。"
        },
        "access": {
          "type": "array",
          "uniqueItems": true,
          "default": ["localhost", "lan", "tailnet"],
          "items": { "$ref": "#/$defs/gatewayAccess" },
          "description": "允许连接的来源。每个请求都要令牌，本机也不例外。"
        },
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": { "$ref": "#/$defs/gatewayHost" },
          "description": "额外接受的 Host 名（域名），并在地址列表里展示。"
        },
        "expose_backends": { "enum": ["all", "favorite"], "default": "all" },
        "pats": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/nodeName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token_file", "scopes"],
            "properties": {
              "token_file": { "type": "string", "minLength": 1 },
              "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scope" } }
            }
          }
        },
        "quota": { "$ref": "#/$defs/quota" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen", "oauth"],
      "properties": {
        "listen": { "enum": ["funnel", "public:443", "tunnel"] },
        "max_pty_per_client": { "type": "integer", "minimum": 1, "default": 8 },
        "pty_budget_file": { "type": "string", "minLength": 1, "description": "本机共享的 PTY 预算文件绝对路径；默认使用入口状态目录中的 ingress-pty.json。" },
        "pty_budget_authority": { "$ref": "#/$defs/nodeName", "description": "托管跨入口主机 PTY 准入租约的 Agent 设备名；多台主机上的入口须配置同一设备。留空表示只在本机协调。" },
        "tunnel_listen": {
          "type": "string",
          "pattern": "^127\\.0\\.0\\.1:[0-9]{1,5}$",
          "description": "只允许 listen 为 tunnel：反向隧道到达入口的本机地址，必须是 127.0.0.1:端口。命令行 --tunnel-listen 优先；省略时为 127.0.0.1:8443。"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "只允许 listen 为 public:443。Funnel 的域名由 Tailscale 分配。"
        },
        "tls": { "enum": ["autocert", "file"] },
        "cert_file": { "type": "string" },
        "key_file": { "type": "string" },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer"],
          "properties": {
            "issuer": { "type": "string", "pattern": "^https://[^/]+$" },
            "clients": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scopes"],
                "properties": {
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/scope" }
                  }
                }
              }
            },
            "dynamic_client_scopes": {
              "type": "array",
              "items": { "$ref": "#/$defs/scope" },
              "default": ["devices:read"],
              "description": "动态注册客户端的 scope 上限。省略时只有 devices:read；空数组表示只能完成 OAuth。"
            },
            "refresh_token_ttl": {
              "$ref": "#/$defs/duration",
              "default": "720h",
              "description": "刷新令牌的有效期，1h 到 8760h（365 天）。每次使用都会换发新的刷新令牌并重新计时，客户端只要在这段时间内回来一次就不必重新授权。省略时为 30 天。"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "listen": { "const": "public:443" } },
            "required": ["listen"]
          },
          "then": { "required": ["domain", "tls"] }
        },
        {
          "if": {
            "not": {
              "properties": { "listen": { "const": "public:443" } },
              "required": ["listen"]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["domain"] },
                { "required": ["tls"] },
                { "required": ["cert_file"] },
                { "required": ["key_file"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "tls": { "const": "file" } },
            "required": ["tls"]
          },
          "then": { "required": ["cert_file", "key_file"] }
        },
        {
          "if": {
            "not": {
              "properties": { "listen": { "const": "tunnel" } },
              "required": ["listen"]
            }
          },
          "then": { "not": { "required": ["tunnel_listen"] } }
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd_policy"],
      "properties": {
        "computer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "pause_on_user_input": { "type": "boolean", "default": false },
            "allow_foreground": { "type": "boolean", "default": false, "description": "Permit explicit foreground control when the executor defaults to background. Configured locally; remote open requests cannot enable it." },
            "endpoint": { "type": "string", "minLength": 1, "description": "用户桌面执行器的本机套接字或命名管道；改变需要重启。" },
            "max_sessions": { "type": "integer", "minimum": 1, "maximum": 32, "default": 16 },
            "lease_seconds": { "type": "integer", "minimum": 10, "maximum": 600, "default": 120 },
            "max_image_bytes": { "type": "integer", "minimum": 1024, "maximum": 4194304, "default": 4194304 }
          }
        },
        "default_cwd": { "type": "string", "minLength": 1 },
        "workspaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "desc": { "type": "string" }
            }
          }
        },
        "cwd_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "deny_file": { "type": "string", "minLength": 1, "description": "禁止目录列表文件的绝对路径，内容是字符串列表（空列表写成 []）；其中的目录始终拒绝，与允许列表是否为空无关。每次工具调用重读，改动无需重启；运行中文件无法加载时沿用上一份成功的列表。" }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_concurrent": { "type": "integer", "minimum": 1, "default": 4 },
            "exclusive_slots": { "type": "integer", "minimum": 1, "default": 1 },
            "default_timeout": { "$ref": "#/$defs/duration" },
            "idempotency_cache": { "type": "integer", "minimum": 1, "default": 200 },
            "inline_output_bytes": { "$ref": "#/$defs/size" }
          }
        },
        "pty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_sessions": { "type": "integer", "minimum": 1, "default": 20 },
            "max_per_caller": { "type": "integer", "minimum": 1, "default": 8 },
            "idle_timeout": { "$ref": "#/$defs/duration" },
            "orphan_grace": { "$ref": "#/$defs/duration" },
            "scrollback_bytes": { "$ref": "#/$defs/size" },
            "default_shell": { "type": "string" },
            "closed_retain": { "$ref": "#/$defs/duration" },
            "closed_retain_max": { "type": "integer", "minimum": 0, "default": 20 }
          }
        },
        "backends": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/backendName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transport", "policy"],
            "properties": {
              "transport": { "enum": ["stdio", "http"] },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "url": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string" },
              "policy": { "enum": ["shared", "exclusive", "per-caller"] },
              "idle_timeout": { "$ref": "#/$defs/duration" },
              "favorite": { "type": "boolean" },
              "shutdown_timeout": { "$ref": "#/$defs/duration" },
              "process_cleanup": { "enum": ["tree"] }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "transport": { "const": "stdio" } },
                  "required": ["transport"]
                },
                "then": { "required": ["command"] }
              },
              {
                "if": {
                  "properties": { "transport": { "const": "http" } },
                  "required": ["transport"]
                },
                "then": { "required": ["url"] }
              }
            ]
          }
        },
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_file_size": {
              "type": "string",
              "pattern": "^(unlimited|[1-9][0-9]*([KMGT]iB|B)?)$",
              "default": "1GiB",
              "description": "单个上传/下载文件的大小上限；unlimited 表示无限制。热更新生效。"
            }
          }
        },
        "disabled_tools": {
          "type": "array",
          "uniqueItems": true,
          "description": "被关闭的内置工具名。缺省或空数组表示全部开启；调用被关闭的工具返回 policy_denied。",
          "items": {"enum": ["backend.acquire", "backend.release", "backend.renew", "computer.act", "computer.action_status", "computer.close", "computer.info", "computer.observe", "computer.open", "computer.renew", "computer.sessions", "exec.output", "exec.run", "fs.delete", "fs.download", "fs.edit", "fs.glob", "fs.grep", "fs.list", "fs.mkdir", "fs.move", "fs.read", "fs.sha256", "fs.stat", "fs.upload", "fs.write", "pty.close", "pty.list", "pty.open", "pty.read", "pty.resize", "pty.signal", "pty.transfer", "pty.write", "sys.info"]}
        },
        "authz": {
          "type": "object",
          "propertyNames": { "pattern": "^tag:[A-Za-z0-9_*-]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["backends", "tools"],
            "properties": {
              "backends": { "type": "array", "items": { "type": "string" } },
              "tools": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "quota": { "$ref": "#/$defs/quota" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isolation": { "enum": ["L0", "L1", "L2"] },
            "allow_dangerous": { "type": "boolean", "default": false },
            "windows_appcontainer": { "type": "boolean", "default": false },
            "exec": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow_cmd": { "type": "array", "items": { "type": "string" } },
                "deny_patterns": { "type": "array", "items": { "type": "string" } }
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "deny_names": { "type": "array", "items": { "type": "string" } },
                "deny_path_substrings": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention": { "$ref": "#/$defs/duration" },
        "dir": { "type": "string" }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "description": "GitHub Actions 运行器托管（CTR-CTL-15）。不含任何密钥：GitHub 凭据在系统钥匙串或 0600 文件里。",
      "properties": {
        "prevent_sleep_while_busy": { "type": "boolean", "default": true },
        "stop_timeout": { "$ref": "#/$defs/duration", "default": "30m" },
        "accounts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "login"],
            "properties": {
              "id": { "$ref": "#/$defs/ciId" },
              "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$", "default": "github.com" },
              "login": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        },
        "bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "target"],
            "properties": {
              "id": { "$ref": "#/$defs/ciId" },
              "scope": { "enum": ["repo"], "default": "repo" },
              "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
              "source": { "enum": ["account", "token", "import"], "default": "account" },
              "account": { "$ref": "#/$defs/ciId" },
              "public": { "type": "boolean" },
              "concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
              "labels": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/ciLabel" } },
              "paused": { "type": "boolean", "default": false },
              "dir": { "type": "string", "minLength": 1 }
            },
            "allOf": [{
              "if": { "properties": { "source": { "const": "import" } }, "required": ["source"] },
              "then": { "properties": { "concurrency": { "const": 1 } } }
            }]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "node": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "gateway"
                }
              }
            },
            "required": [
              "roles"
            ]
          }
        },
        "required": [
          "node"
        ]
      },
      "then": {
        "required": [
          "gateway"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "node": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "ingress"
                }
              }
            },
            "required": [
              "roles"
            ]
          }
        },
        "required": [
          "node"
        ]
      },
      "then": {
        "required": [
          "ingress"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "node": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "agent"
                }
              }
            },
            "required": [
              "roles"
            ]
          }
        },
        "required": [
          "node"
        ]
      },
      "then": {
        "properties": {
          "agent": {
            "required": [
              "cwd_policy"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "mesh": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "mode"
                  ]
                },
                {
                  "required": [
                    "control_url"
                  ]
                },
                {
                  "required": [
                    "authkey_file"
                  ]
                },
                {
                  "required": [
                    "auth_method"
                  ]
                },
                {
                  "required": [
                    "ephemeral"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "mesh": {
            "required": [
              "mode"
            ],
            "not": {
              "required": [
                "tailnet"
              ]
            }
          }
        }
      }
    }
  ]
}
