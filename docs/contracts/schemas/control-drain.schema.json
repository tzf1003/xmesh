{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xmesh:schema:control-drain:2",
  "title": "ControlDrain",
  "description": "CTR-CTL-06\u3002POST /v2/drain \u4e0e POST /v2/resume\u3002drain \u72b6\u6001\u53ea\u5728\u5185\u5b58\uff0c\u5185\u6838\u91cd\u542f\u540e\u590d\u4f4d\u3002",
  "$defs": {
    "DrainState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draining",
        "mode",
        "since"
      ],
      "properties": {
        "draining": {
          "type": "boolean"
        },
        "mode": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/DrainMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "draining \u4e3a false \u65f6\u662f null\u3002"
        },
        "since": {
          "oneOf": [
            {
              "$ref": "urn:xmesh:schema:control-common:2#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "\u8fdb\u5165\u5f53\u524d drain \u7684\u65f6\u95f4\u3002keep \u5347\u7ea7\u4e3a kill \u65f6\u4e0d\u91cd\u7f6e\u3002draining \u4e3a false \u65f6\u662f null\u3002"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "draining": {
                "const": true
              }
            },
            "required": [
              "draining"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "type": "string"
              },
              "since": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "mode": {
                "type": "null"
              },
              "since": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "DrainRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "urn:xmesh:schema:control-common:2#/$defs/DrainMode",
          "default": "keep"
        },
        "scope": {
          "enum": [
            "local",
            "device",
            "mesh"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "DrainResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drain",
        "closed_pty",
        "released_leases"
      ],
      "properties": {
        "drain": {
          "$ref": "#/$defs/DrainState"
        },
        "closed_pty": {
          "type": "integer",
          "minimum": 0,
          "description": "\u8fd9\u6b21\u8bf7\u6c42\u65b0\u7ec8\u6b62\u7684 PTY \u6570\u3002keep \u4e0e resume \u6052\u4e3a 0\u3002"
        },
        "released_leases": {
          "type": "integer",
          "minimum": 0,
          "description": "\u8fd9\u6b21\u8bf7\u6c42\u65b0\u91ca\u653e\u7684\u79df\u7ea6\u6570\u3002keep \u4e0e resume \u6052\u4e3a 0\u3002"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrainOutcome"
          }
        }
      }
    },
    "DrainOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
