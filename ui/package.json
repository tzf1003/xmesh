{
  "name": "xmesh-ui",
  "version": "0.0.0",
  "private": true,
  "description": "xmesh desktop tray shell (Electron)",
  "author": "xmesh authors",
  "main": "dist/src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && node scripts/flip-fuses.mjs --profile test && playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "fake-kernel": "npm run build && node dist/testserver/cli.js",
    "start": "npm run build && electron .",
    "verify-fuses": "node scripts/flip-fuses.mjs --verify --profile release",
    "sync-types": "node scripts/sync-control-types.mjs",
    "check-types": "node scripts/sync-control-types.mjs --check",
    "package": "npm run build && electron-builder --config electron-builder.config.mjs",
    "icon": "node scripts/gen-app-icon.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
