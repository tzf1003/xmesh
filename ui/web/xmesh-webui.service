# systemd user unit for the xmesh web management panel (ui/README.md「Linux 网页管理界面」).
# Install:  cp xmesh-webui.service ~/.config/systemd/user/ && systemctl --user enable --now xmesh-webui
# Key:      journalctl --user -u xmesh-webui shows it on first start; `node <dir>/xmesh-webui.js --print-key` prints it again.
# Run as the user that runs the xmesh kernel: the panel finds it under that user's ~/.config/xmesh.
[Unit]
Description=xmesh web management panel
After=network-online.target

[Service]
# Point this at the unpacked release archive.
ExecStart=/usr/bin/env node %h/.local/share/xmesh-webui/xmesh-webui.js --listen 127.0.0.1:7480
# For access from other hosts, serve HTTPS instead:
#   --listen 0.0.0.0:7480 --tls-cert %h/.config/xmesh-webui/tls.crt --tls-key %h/.config/xmesh-webui/tls.key
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
